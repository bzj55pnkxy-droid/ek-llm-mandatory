# Copy to .env and edit. Gitignored.

# Image tags are pinned deliberately: both projects ship floating `latest` tags
# and changed their entrypoints incompatibly between releases, so an unpinned
# pull breaks a working setup with no local change.

OPENHANDS_IMAGE=docker.openhands.dev/openhands/openhands:1.8
OPENHANDS_AGENT_SERVER_IMAGE=ghcr.io/openhands/agent-server
OPENHANDS_AGENT_SERVER_TAG=1.26.0-python
PI_NODE_IMAGE=node:24-slim

# Loopback only. The agent runs model-authored shell commands with network
# access — anything that can reach this port inherits that.
OPENHANDS_PORT=3000

# Must be an ABSOLUTE path. OpenHands' sandbox containers are spawned by the
# host daemon, which resolves SANDBOX_VOLUMES against the host filesystem.
# Point this at the same directory as ./workspace.
WORKSPACE_DIR=/Users/you/llm-mandatory/workspace

SANDBOX_MEMORY=4g
SANDBOX_CPUS=2
SANDBOX_PIDS_LIMIT=512

# Ollama LLM endpoint configuration
# Set to your Ollama host IP or hostname (defaults to localhost)
OLLAMA_HOST=localhost
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_BASE_URL_11435=http://localhost:11435/v1
LLM_BASE_URL=http://localhost:11434/v1
